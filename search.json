---
layout: null
permalink: /search.json
---
{%- assign sep = "" -%}
[
{%- for post in site.posts -%}
{{ sep }}{"title": {{ post.title | jsonify }}, "url": {{ post.url | relative_url | jsonify }}, "date": {{ post.date | date: "%Y-%m-%d" | jsonify }}, "kind": "post", "body": {{ post.content | strip_html | normalize_whitespace | truncate: 1200 | jsonify }}}
{%- assign sep = "," -%}
{%- endfor -%}
{%- assign nav_pages = site.html_pages | where_exp: "p", "p.title" | where_exp: "p", "p.url != '/404.html'" -%}
{%- for p in nav_pages -%}
{{ sep }}{"title": {{ p.title | jsonify }}, "url": {{ p.url | relative_url | jsonify }}, "date": "", "kind": "page", "body": {{ p.content | strip_html | normalize_whitespace | truncate: 1200 | jsonify }}}
{%- assign sep = "," -%}
{%- endfor -%}
]
